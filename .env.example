# Copy to .env and fill in. Never commit .env.

# Public hostname that points at this server (Telegram webhooks need HTTPS)
DOMAIN=omulimu.example.com
# Any long random string; keep it, n8n encrypts credentials with it (openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# From @BotFather. Also goes into the "Omulimu Telegram bot" credential (used by the Telegram Trigger).
TELEGRAM_BOT_TOKEN=

# OpenAI-compatible endpoint. OpenRouter by default; for OpenAI use https://api.openai.com/v1 and gpt-4o-mini.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# Optional: OpenAI key for the classifier. When set, the classifier uses OpenAI's Decisions API
# (POST /v1/decisions, gpt-6-luna) instead of a chat call. CLASSIFIER_MODE=chat|decisions forces either one.
OPENAI_API_KEY=
CLASSIFIER_MODE=
DECISIONS_MODEL=gpt-6-luna
# Optional: a different model for the Coach brain only
LLM_COACH_MODEL=

# Shown in Care template 1 and 2. Confirm the right line with the client before going live.
SUPPORT_LINE=REPLACE_WITH_THE_SUPPORT_LINE_THE_CLIENT_CONFIRMS
# Your own Telegram chat id (message @userinfobot). Care alerts and error alerts go here.
ADMIN_CHAT_ID=

# Test switch for R5 / T7: true makes every LLM call fail (the /fail_llm command does it for one message)
FORCE_LLM_FAIL=false
